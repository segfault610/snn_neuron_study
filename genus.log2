#@ Processing -files option
@genus 1> source asic/scripts/run_genus.tcl
#@ Begin verbose source ./asic/scripts/run_genus.tcl
@file(run_genus.tcl) 9: set project_dir $::env(PROJECT_DIR)
@file(run_genus.tcl) 10: set model       $::env(MODEL)
@file(run_genus.tcl) 11: set corner      $::env(CORNER)
@file(run_genus.tcl) 12: set design_kind $::env(DESIGN_KIND)
@file(run_genus.tcl) 14: set pdk_dir "/home/cadence/install/FOUNDRY/digital/90nm/dig"
@file(run_genus.tcl) 15: set lib_file "${pdk_dir}/lib/${corner}.lib"
@file(run_genus.tcl) 18: switch -- $model {
    lif {
        set neuron_file "${project_dir}/rtl/lif/lif_neuron.sv"
        set layer_file  "${project_dir}/rtl/lif/lif_layer.sv"
        set neuron_top  "lif_neuron"
        set layer_top   "lif_layer"
    }
    izhikevich {
        set neuron_file "${project_dir}/rtl/izhikevich/izhikevich_neuron.sv"
        set layer_file  "${project_dir}/rtl/izhikevich/izhikevich_layer.sv"
        set neuron_top  "izhikevich_neuron"
        set layer_top   "izhikevich_layer"
    }
    hodgkin_huxley {
        set neuron_file "${project_dir}/rtl/hodgkin_huxley/hodgkin_huxley_neuron.sv"
        set layer_file  "${project_dir}/rtl/hodgkin_huxley/hodgkin_huxley_layer.sv"
        set neuron_top  "hodgkin_huxley_neuron"
        set layer_top   "hodgkin_huxley_layer"
    }
    default {
        error "Unknown MODEL=$model"
    }
}
@file(run_genus.tcl) 43: switch -- $design_kind {
    neuron {
        set top_module $neuron_top
        set rtl_files [list $neuron_file]
    }
    layer {
        set top_module $layer_top
        set rtl_files [list $neuron_file $layer_file]
    }
    default {
        error "DESIGN_KIND must be neuron or layer; got '$design_kind'"
    }
}
@file(run_genus.tcl) 58: set out_dir    "${project_dir}/asic/genus/${model}/${design_kind}/${corner}"
@file(run_genus.tcl) 59: set report_dir "${project_dir}/asic/reports/${model}/${design_kind}/${corner}"
@file(run_genus.tcl) 61: file mkdir $out_dir
@file(run_genus.tcl) 62: file mkdir $report_dir
@file(run_genus.tcl) 65: foreach f $rtl_files {
    if {![file exists $f] || [file size $f] == 0} {
        error "RTL missing or empty: $f"
    }
}
@file(run_genus.tcl) 71: if {![file exists $lib_file]} {
    error "Liberty file missing: $lib_file"
}
@file(run_genus.tcl) 75: puts "INFO: MODEL=$model DESIGN_KIND=$design_kind CORNER=$corner"
INFO: MODEL=hodgkin_huxley DESIGN_KIND=layer CORNER=typical
@file(run_genus.tcl) 76: puts "INFO: TOP=$top_module"
