#!/bin/csh -f

cd /home/userdata/24bvd0198/snn_neuron_study

# Load the Cadence environment from the current C-shell setup.
rehash

# Record executable paths and environment for debugging.
setenv PROJECT_DIR /home/userdata/24bvd0198/snn_neuron_study

echo "PROJECT_DIR=$PROJECT_DIR"
echo "PATH=$PATH"

echo "===== EXECUTABLE DISCOVERY ====="
which xrun
which genus
which lec
which conformal

# Known Xcelium installation path from this server.
if (-x /home/cadence/install_RB_8.7/XCELIUM2409/tools/bin/xrun) then
    setenv XRUN /home/cadence/install_RB_8.7/XCELIUM2409/tools/bin/xrun
endif

# Resolve Genus and Xcelium using the current C-shell PATH.
set GENUS_PATH = `which genus`
set XRUN_PATH = `which xrun`

if ("$GENUS_PATH" != "") then
    setenv GENUS "$GENUS_PATH"
endif

if ("$XRUN_PATH" != "") then
    setenv XRUN "$XRUN_PATH"
endif

# Export the C-shell environment for the child Bash process.
# This is generated by the shell itself, preserving exported variables.
/usr/bin/env > /tmp/cadence_env_${USER}.txt

echo "===== ENVIRONMENT CAPTURED ====="
echo "Environment file: /tmp/cadence_env_${USER}.txt"

# Run Bash with the captured environment.
# Use env -i to avoid inheriting a conflicting environment.
# Preserve PATH and required Cadence variables.
setenv ENV_CAPTURE /tmp/cadence_env_${USER}.txt

# Create a Bash-compatible environment file from env output.
awk '
index($0, "=") {
    key = substr($0, 1, index($0, "=")-1)
    value = substr($0, index($0, "=")+1)
    gsub(/\047/, "\047\\\047\047", value)
    print "export " key "=\047" value "\047"
}' "$ENV_CAPTURE" > /tmp/cadence_env_${USER}.sh

chmod 600 /tmp/cadence_env_${USER}.sh

# Start detached workflow with a persistent log.
nohup /bin/bash -c 'source /tmp/cadence_env_'${USER}'.sh; cd /home/userdata/24bvd0198/snn_neuron_study; exec ./asic/scripts/run_everything.sh' >&! run_background.log < /dev/null &

echo "Workflow launch requested."
echo "Background log: /home/userdata/24bvd0198/snn_neuron_study/run_background.log"
CSHEOF

chmod +x launch_asic.csh

# ============================================================
# 2. LAUNCH
# ============================================================

./launch_asic.csh

# ============================================================
# 3. WAIT AND CHECK
# ============================================================

sleep 10

echo "===== BACKGROUND LOG ====="
tail -40 run_background.log

echo "===== LATEST SUMMARY ====="
set latest = `ls -1dt results/run_* | head -1`
cat "$latest/summary.tsv"

echo "===== ACTIVE PROCESSES ====="
ps -u "$USER" -o pid,stat,etime,args | grep -E '[r]un_everything|[x]run|[g]enus|[c]onformal|[l]ec'

echo "===== LOG AND ARCHIVE FILES ====="
ls -lh run_background.log
ls -lht results/snn_run_*.tar.gz
